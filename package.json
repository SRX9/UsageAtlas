{
  "name": "usageatlas-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test build",
    "dev": "turbo run dev --env-mode=loose",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate:desktop-icons": "bun tooling/generate-desktop-icons.mjs",
    "desktop:start": "turbo run dev --filter=@usageatlas/desktop --env-mode=loose",
    "desktop:lint": "turbo run lint --filter=@usageatlas/desktop",
    "desktop:typecheck": "turbo run typecheck --filter=@usageatlas/desktop",
    "desktop:build": "turbo run build --filter=@usageatlas/desktop",
    "desktop:test": "turbo run test --filter=@usageatlas/desktop",
    "desktop:package": "turbo run package --filter=@usageatlas/desktop --env-mode=loose --",
    "desktop:make": "turbo run make --filter=@usageatlas/desktop --env-mode=loose --"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "png-to-ico": "3.0.2",
    "pngjs": "7.0.0",
    "turbo": "2.10.7"
  },
  "trustedDependencies": [
    "@zowe/secrets-for-zowe-sdk",
    "electron-winstaller",
    "fs-xattr",
    "macos-alias"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}