{
  "name": "@usageatlas/desktop",
  "private": true,
  "version": "0.2.9",
  "description": "Cross-platform UsageAtlas desktop application",
  "author": "UsageAtlas contributors",
  "homepage": "https://usageatlas.com",
  "license": "MIT",
  "productName": "UsageAtlas",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "bun run dev",
    "build": "vite build --config vite.renderer.config.ts --outDir ../../.vite/renderer-check --emptyOutDir && tsc --noEmit",
    "lint": "eslint forge.config.cjs eslint.config.mjs vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@lobehub/icons": "^5.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@usageatlas/contracts": "workspace:*",
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "electron-squirrel-startup": "1.0.1",
    "motion": "^12.23.24",
    "posthog-node": "5.47.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-base": "7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^10.0.1",
    "@reforged/maker-appimage": "5.2.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
